{
  "name": "bca-mycoreplus",
  "type": "module",
  "version": "0.1.0",
  "description": "Web application for BCA MyCore+.",
  "author": {
    "name": "Septianata Rizky Pratama",
    "email": "ian.rizkypratama@gmail.com"
  },
  "private": true,
  "license": "MIT",
  "engineStrict": true,
  "engines": {
    "bun": "^1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianriizky/bca-mycoreplus.git"
  },
  "bugs": {
